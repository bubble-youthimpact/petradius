rules_version = '2';

// PetRadius — Firestore security rules
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Each signed-in user can read and write only their own profile and quiz results.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'photoURL', 'location', 'phone',
             'bio', 'favorites',
             'createdAt', 'updatedAt', 'lastLoginAt'
           ])
        && (!('favorites' in request.resource.data) || request.resource.data.favorites.size() <= 500)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 600);

      match /quizResults/{resultId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'quizId', 'quizSlug', 'quizTitle', 'type', 'score', 'total', 'result', 'takenAt'
             ]);
        allow update: if false;
      }
    }
  }
}
